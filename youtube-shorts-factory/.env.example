# ─── YouTube Data API v3 (sourcing + upload) ─────────────────────────────
# 1) Sourcing: Create an API key in Google Cloud Console
YOUTUBE_API_KEY=AIzaSy_replace_me

# 2) Upload: OAuth 2.0 client_secret.json path (Desktop or Web app credentials)
#    First-run will open a browser to authorize; token stored at TOKEN_PATH.
YOUTUBE_OAUTH_CLIENT_SECRET=./credentials/client_secret.json
YOUTUBE_OAUTH_TOKEN_PATH=./credentials/token.json
YOUTUBE_CHANNEL_NAME=Global Shorts Factory

# ─── LLM provider (pick ONE primary; others act as fallback) ─────────────
# Groq (fast & cheap — recommended for viral analysis + translation)
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (fallback)
OPENAI_API_KEY=sk-replace_me
OPENAI_MODEL=gpt-4o-mini

# Anthropic (fallback)
ANTHROPIC_API_KEY=sk-ant-replace_me
ANTHROPIC_MODEL=claude-sonnet-4-6

# Preferred order, comma separated. First available wins.
LLM_PROVIDER_ORDER=groq,openai,anthropic

# ─── DeepL (optional, high-accuracy translation) ─────────────────────────
DEEPL_API_KEY=

# ─── Whisper config ──────────────────────────────────────────────────────
# Tiers: tiny, base, small, medium, large-v3, turbo
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto      # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto  # auto | int8 | int8_float16 | float16 | float32

# ─── Optional proxy for yt-dlp (region-locked content) ───────────────────
YT_DLP_PROXY=

# ─── Pixabay (royalty-free music + stock footage fallback) ───────────────
PIXABAY_API_KEY=

# ─── Runtime ─────────────────────────────────────────────────────────────
TZ=UTC
LOG_LEVEL=INFO
# When DRY_RUN=1, videos are produced but NOT uploaded.
DRY_RUN=0
